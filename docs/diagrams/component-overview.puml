@startuml
title Component Overview
skinparam componentStyle rectangle
skinparam shadowing false

package "Frontend" {
  [App.tsx\nstate + SSE + layout] as App
  [UrlAnalyzer.tsx\nlink + cookies row] as UrlAnalyzer
  [AnalysisPanel.tsx\nentries + summary] as AnalysisPanel
  [DownloadOptionsPanel.tsx\nmode/quality/subtitles] as OptionsPanel
  [SettingsPanel.tsx\npaths, concurrency, proxy] as SettingsPanel
  [JobQueue.tsx\ntask center] as Queue
  [ProxySection.tsx\nproxy result + probe] as ProxySection
  [CookieSection.tsx\ncookie state + verify] as CookieSection
  [HelpPopover.tsx\nnon-modal help overlay] as HelpPopover
  [SearchableLanguageSelect.tsx] as LanguageSelect
  [Toggle.tsx / StatusPill.tsx\nprimitives] as Primitives
  [BiliIcon.tsx\nbilibili logo] as BiliIcon
  [BiliUploadButton.tsx\njob row entry] as BiliButton
  [BiliUploadDialog.tsx\nsingle + collection form] as BiliDialog
  [BiliJobStatus.tsx\nbadge + detail rows] as BiliJobStatus
  [BiliLoginSection.tsx\npreflight + login] as BiliLogin
  [api.ts\nHTTP boundary] as ApiClient
  [types.ts] as Types
  [quality.ts] as Quality
  [formatting.ts] as Formatting
  [subtitles.ts\nsubtitle labels + source] as Subtitles
  [cookieLock.ts\nbrowser-locked mapping] as CookieLock
}

package "Backend / entry" {
  [main.py\ncomposition root + lifespan] as Main
  [api/routers/*\nHTTP endpoints] as Routers
  [api/api_context.py\nrequest dependencies] as ApiCtx
  [api/api_support.py\nendpoint helpers] as ApiSupport
  [download/job_artifacts.py\nartifact location] as JobArtifacts
  [contracts/schemas.py\nrequest/response models] as Schemas
  [contracts/config.py\nAppSettings] as Config
}

package "Backend / orchestration" {
  [download/job_manager.py\nqueue + workers] as Manager
  [download/job_read_model.py\nAPI projection] as ReadModel
  [infra/events.py\nEventBroker (SSE)] as Broker
  [bilibili/bili_manager.py\nupload queue, single worker] as BiliManager
  [bilibili/bili_read_model.py\nbadge aggregation] as BiliReadModel
}

package "Backend / download" {
  [download/ytdlp_service.py\nyt-dlp boundary] as Service
  [download/ytdlp_formats.py\nselectors] as Formats
  [download/stall_guard.py\nstall watchdog] as StallGuard
  [host/browser_cookies.py\ncookie import] as Cookies
  [host/system_open.py\nplayer / folder opener] as SystemOpen
  [download/output_paths.py\noutput discovery] as OutputPaths
}

package "Backend / bili upload" {
  [bilibili/bili_upload.py\nsingle upload flow] as BiliUpload
  [bilibili/bili_bin.py\nbiliup boundary] as BiliBin
  [bilibili/bili_api.py\nreconcile, season, reply] as BiliApi
  [bilibili/bili_auth.py\nqr login + cookie file] as BiliAuth
  [bilibili/bili_meta.py\nmetadata + limits] as BiliMeta
  [bilibili/bili_policy.py\nmessages + badges] as BiliPolicy
  [bilibili/bili_http.py\nHTTP seam] as BiliHttp
}

package "Backend / progress" {
  [download/download_progress.py\nstream aggregation] as Progress
  [download/progress_persist.py\npersist gate] as PersistGate
  [download/transfer_stats.py\naverage speed] as Stats
}

package "Backend / self-check" {
  [host/proxy.py\nproxy resolution] as ProxyResolver
  [host/connectivity.py\nproxy proof] as Connectivity
  [host/cookie_health.py\ncookie report] as CookieHealth
  [download/error_advice.py\nexception -> advice] as ErrorAdvice
  [host/runtime_env.py\nhostile env scrubbing] as RuntimeEnv
}

package "Backend / support" {
  [contracts/models.py\nSQLModel tables] as Models
  [infra/db.py\nengine + pragmas] as DB
  [download/fallback_policy.py\ndowngrade messages] as Fallback
  [download/resolution_decisions.py\ndowngrade decisions] as Decisions
  [common/paths.py\nsafe names] as Paths
  [common/log_safety.py\nlog scrubbing] as LogSafety
  [infra/logging_setup.py\nfile logging] as LoggingSetup
  [host/dev_server.py\nport occupant probe] as DevServer
}

