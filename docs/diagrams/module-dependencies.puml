@startuml
title Backend Module Dependencies
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "L0 entry" {
  [main.py\ncomposition root] as Main
  [__main__.py\ncli entry] as Entry
  [api/routers/*\nHTTP endpoints] as Routers
  [api/api_context.py\nrequest dependencies] as ApiCtx
  [api/api_support.py\nendpoint helpers] as ApiSupport
  [download/job_artifacts.py\nartifact location] as Artifacts
  [host/dev_server.py\nport probe, occupant] as DevServer
}

package "L1 contracts" {
  [contracts/config.py\nAppSettings] as Config
  [contracts/schemas.py\nwire models] as Schemas
  [contracts/models.py\nSQLModel tables] as Models
}

package "L2 orchestration" {
  [download/job_manager.py\nqueue, workers, state machine] as Manager
  [download/job_read_model.py\nAPI projection] as ReadModel
  [download/orphan_recovery.py\nstartup reconciliation] as Recovery
  [infra/events.py\nEventBroker] as Broker
  [bilibili/bili_manager.py\nbilibili queue, single worker] as BiliManager
  [bilibili/bili_read_model.py\nbilibili badges and read models] as BiliReadModel
}

package "L3 domain and policy" {
  [download/ytdlp_service.py\nyt-dlp boundary] as Service
  [download/ytdlp_formats.py\nselectors, fallback math] as Formats
  [download/subtitle_plan.py\nsubtitle decisions] as SubtitlePlan
  [download/stall_guard.py\nstall watchdog] as Stall
  [download/fallback_policy.py\nreason and message] as Fallback
  [download/resolution_decisions.py\ndowngrade decisions] as Decisions
  [host/browser_cookies.py\ncookie import] as Cookies
  [host/cookie_health.py\ncookie verification] as CookieHealth
  [host/proxy.py\nproxy resolution] as Proxy
  [host/connectivity.py\nproxy probe] as Connectivity
  [download/error_advice.py\nexception to advice] as Advice
  [download/download_progress.py\nsubstream aggregation] as Progress
  [download/progress_persist.py\npersist gate] as Gate
  [download/transfer_stats.py\naverage speed] as Stats
  [download/output_paths.py\npath discovery] as Outputs
  [download/safe_delete.py\ndeletion whitelist] as Deletion
  [host/system_open.py\nplayer and folder] as Opener
  [bilibili/bili_upload.py\nsingle upload flow] as BiliUpload
  [bilibili/bili_bin.py\nbiliup boundary] as BiliBin
  [bilibili/bili_api.py\nbilibili member APIs] as BiliApi
  [bilibili/bili_auth.py\nqr login, cookie file] as BiliAuth
  [bilibili/bili_meta.py\nmetadata and limits] as BiliMeta
  [bilibili/bili_policy.py\nbilibili messages, badges] as BiliPolicy
  [bilibili/bili_subtitle.py\nCC subtitle upload] as BiliSubtitle
}

package "L4 infrastructure" {
  [infra/db.py\nengine, pragmas, migrations] as DB
  [infra/logging_setup.py\nroot logger, rotating file] as Logging
  [bilibili/bili_http.py\nbilibili HTTP seam] as BiliHttp
}

package "L5 pure helpers" {
  [common/paths.py\nsafe path names] as Paths
  [common/log_safety.py\nlog scrubbing] as LogSafe
  [host/runtime_env.py\nhostile env scrubbing] as RuntimeEnv
}

