  [host/system_open.py] as SystemOpen
  [bilibili/bili_manager.py] as BiliManager
  [bilibili/bili_read_model.py] as BiliReadModel
  [bilibili/bili_upload.py] as BiliUploadDomain
  [bilibili/bili_bin.py] as BiliBin
  [bilibili/bili_api.py] as BiliApi
