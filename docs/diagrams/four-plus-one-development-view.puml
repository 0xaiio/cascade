@startuml
title 4+1 Development View
skinparam componentStyle rectangle
skinparam shadowing false

package "frontend/src" {
  [App.tsx] as App
  [components/UrlAnalyzer.tsx] as UrlAnalyzer
  [components/AnalysisPanel.tsx] as AnalysisPanel
  [components/DownloadOptionsPanel.tsx] as OptionsPanel
  [components/SettingsPanel.tsx] as SettingsPanel
  [components/SearchableLanguageSelect.tsx] as LanguageSelect
  [components/Toggle.tsx] as Toggle
