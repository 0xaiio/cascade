  [bilibili/bili_meta.py] as BiliMeta
  [bilibili/bili_policy.py] as BiliPolicy
  [bilibili/bili_http.py] as BiliHttp
}

package "tests" {
  [backend/tests] as BackendTests
  [frontend/src/*.test.tsx] as FrontendTests
}

package "scripts" {
  [docs.py] as DocsScript
  [check_doc_anchors.py] as AnchorScript
  [acceptance_network.py] as AcceptanceNetwork
  [bench_concurrency.py] as BenchConcurrency
  [bench_throttle_guard.py] as BenchThrottle
  [export_cookies_via_cdp.py] as CookieExport
  [acceptance_real.py] as AcceptanceReal
}

